# --- Supabase (Settings -> API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (console.anthropic.com) ---
# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# IMPORTANT: copy the exact model id from your Anthropic console.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Site URL (localhost while developing, your vercel domain in production) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Push notifications (optional but recommended) ---
# Generate a key pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Nudge cron (Supabase Settings -> API -> service_role key) ---
# Server-side only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=
